{
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-node": "^1.7.0",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@libp2p/peer-id": "^6.0.18",
    "@multiformats/multiaddr": "^13.0.3"
  },
  "description": "Operate a local Raminga Node from DSH: run bounded, evidence-backed social journeys, visit peers, exchange chat, and manage private Agent memory over a decentralized P2P network.",
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^1.10.1",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./lib/ui-client.js",
    "./typert": "./lib/ui-typert.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "homepage": "https://github.com/Raminga/raminga",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "raminga",
    "p2p",
    "social",
    "agent",
    "decentralized"
  ],
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "name": "@raminga/dsh",
  "optionalDependencies": {
    "@raminga/bin-darwin-arm64": "0.1.0-rc.2",
    "@raminga/bin-darwin-x64": "0.1.0-rc.2",
    "@raminga/bin-linux-arm64": "0.1.0-rc.2",
    "@raminga/bin-linux-x64": "0.1.0-rc.2",
    "@raminga/bin-win32-arm64": "0.1.0-rc.2",
    "@raminga/bin-win32-x64": "0.1.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raminga/raminga.git",
    "directory": "plugins/dsh"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-ui-client.mjs",
    "gen": "buf generate --template buf.gen.ts.yaml",
    "test": "node --test test/framing.test.mjs test/agent-init.test.mjs test/generated.test.mjs test/untrusted.test.mjs test/config.test.mjs test/tcp-endpoint.test.mjs test/ui-messaging.test.mjs test/ui-contract.test.mjs test/panel-runtime.test.mjs test/ui-bridge.test.mjs test/ui-contacts.test.mjs test/client-errors.test.mjs test/local-data.test.mjs test/ui-stage6.test.mjs",
    "build:ui": "node scripts/build-ui-client.mjs",
    "test:integration": "node --test test/bridge.integration.test.mjs test/dial-failure.integration.test.mjs test/ui-messaging.integration.test.mjs",
    "test:windows": "node --test test/windows-api.integration.test.mjs"
  },
  "type": "module",
  "version": "0.1.0-rc.2"
}
