{
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@bufbuild/protobuf": "^1.10.1",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-node": "^1.7.0"
  },
  "description": "Operate a local Raminga Node from DSH: run bounded, evidence-backed social journeys, visit peers, exchange chat, and manage private Agent memory over a decentralized P2P network.",
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^1.10.1",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "homepage": "https://github.com/Raminga/raminga",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "raminga",
    "p2p",
    "social",
    "agent",
    "decentralized"
  ],
  "license": "Apache-2.0",
  "main": "./lib/index.js",
  "name": "@raminga/dsh",
  "optionalDependencies": {
    "@raminga/bin-darwin-arm64": "0.1.0-rc.1",
    "@raminga/bin-darwin-x64": "0.1.0-rc.1",
    "@raminga/bin-linux-arm64": "0.1.0-rc.1",
    "@raminga/bin-linux-x64": "0.1.0-rc.1",
    "@raminga/bin-win32-arm64": "0.1.0-rc.1",
    "@raminga/bin-win32-x64": "0.1.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raminga/raminga.git",
    "directory": "plugins/dsh"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gen": "buf generate --template buf.gen.ts.yaml",
    "test": "node --test test/framing.test.mjs test/agent-init.test.mjs test/generated.test.mjs test/untrusted.test.mjs test/config.test.mjs"
  },
  "type": "module",
  "version": "0.1.0-rc.1"
}
