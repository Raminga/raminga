#!/bin/sh
# A deliberately small systemctl stand-in for tests/install/systemd-inner.sh.
# It runs the unit's ExecStart command with INVOCATION_ID set and remembers the
# PID, so the install script can exercise its real API health checks without
# requiring systemd. It is not a systemd implementation.
set -eu

STATE=${FAKE_SYSTEMD_STATE:-/run/fake-systemd}
UNIT=${FAKE_SYSTEMD_UNIT:-/etc/systemd/system/raminga.service}
LOG=$STATE/unit.log
PIDFILE=$STATE/pid

mkdir -p "$STATE"
printf '%s\n' "$*" >>"$STATE/calls.log"

cmd=${1:-}
[ "$#" -eq 0 ] || shift

is_running() {
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE")
	[ -n "$pid" ] || return 1
	kill -0 "$pid" 2>/dev/null
}

is_active() {
	if [ "${FAKE_SYSTEMD_NEVER_ACTIVE:-0}" = 1 ]; then
		return 1
	fi
	is_running
}

start_unit() {
	[ -f "$UNIT" ] || {
		echo "Unit raminga.service not found." >&2
		exit 5
	}
	if [ "${FAKE_SYSTEMD_FAIL_START:-0}" = 1 ]; then
		echo "Job for raminga.service failed because the control process exited with error code." >&2
		exit 1
	fi
	line=$(sed -n 's/^ExecStart=//p' "$UNIT" | sed -n '1p')
	[ -n "$line" ] || {
		echo "Unit raminga.service has no ExecStart." >&2
		exit 5
	}
	user=$(sed -n 's/^User=//p' "$UNIT" | sed -n '1p')
	[ -n "$user" ] || user=root
	cmd="exec $line"
	if [ "${FAKE_SYSTEMD_UNSUPERVISED:-0}" != 1 ]; then
		cmd="export INVOCATION_ID=fake-systemd; $cmd"
	fi
	if [ "$user" = root ]; then
		sh -c "$cmd" >>"$LOG" 2>&1 &
	else
		# Like systemd, run the service process as the unit's User=. The test
		# image has no real systemd, but this is enough to exercise the API's
		# endpoint-owner check for a non-root service user.
		su -s /bin/sh "$user" -c "$cmd" >>"$LOG" 2>&1 &
	fi
	pid=$!
	printf '%s\n' "$pid" >"$PIDFILE"
	if [ "${FAKE_SYSTEMD_EXIT_AFTER_START:-0}" = 1 ]; then
		(sleep 0.3; kill -TERM "$pid" 2>/dev/null || true) &
	fi
	sleep 0.1
}

stop_unit() {
	pid=
	if [ -f "$PIDFILE" ]; then
		pid=$(cat "$PIDFILE")
	fi
	if [ -n "$pid" ]; then
		kill -TERM "$pid" 2>/dev/null || true
		i=0
		while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 100 ]; do
			sleep 0.05
			i=$((i + 1))
		done
		if kill -0 "$pid" 2>/dev/null; then
			kill -KILL "$pid" 2>/dev/null || true
		fi
	fi
	rm -f "$PIDFILE"
}

case "$cmd" in
daemon-reload)
	exit 0
	;;
is-active)
	quiet=0
	for arg in "$@"; do
		if [ "$arg" = --quiet ]; then
			quiet=1
		fi
	done
	if is_active; then
		[ "$quiet" -eq 1 ] || echo active
		exit 0
	fi
	[ "$quiet" -eq 1 ] || echo inactive
	exit 3
	;;
is-enabled)
	if [ -f "$STATE/enabled" ]; then
		echo enabled
	else
		echo disabled
	fi
	exit 0
	;;
enable)
	now=0
	for arg in "$@"; do
		if [ "$arg" = --now ]; then
			now=1
		fi
	done
	touch "$STATE/enabled"
	if [ "$now" -eq 1 ]; then
		start_unit
	fi
	exit 0
	;;
disable)
	now=0
	for arg in "$@"; do
		if [ "$arg" = --now ]; then
			now=1
		fi
	done
	rm -f "$STATE/enabled"
	if [ "$now" -eq 1 ]; then
		stop_unit
	fi
	exit 0
	;;
start)
	start_unit
	exit 0
	;;
stop)
	stop_unit
	exit 0
	;;
restart)
	stop_unit
	start_unit
	exit 0
	;;
status)
	if is_active; then
		echo "● raminga.service - Raminga node"
		echo "   Active: active (running)"
	else
		echo "● raminga.service - Raminga node"
		echo "   Active: inactive (dead)"
	fi
	if [ -f "$LOG" ]; then
		tail -n 10 "$LOG"
	fi
	exit 0
	;;
cat)
	[ -f "$UNIT" ] || exit 5
	cat "$UNIT"
	;;
show)
	prop=
	value=0
	while [ "$#" -gt 0 ]; do
		case "$1" in
		-p | --property)
			prop=$2
			shift 2
			;;
		--value)
			value=1
			shift
			;;
		*) shift ;;
		esac
	done
	case "$prop" in
	MainPID)
		if is_active; then
			cat "$PIDFILE"
		else
			echo 0
		fi
		;;
	ActiveState)
		if is_active; then
			echo active
		else
			echo inactive
		fi
		;;
	LoadState)
		if [ -f "$UNIT" ]; then
			echo loaded
		else
			echo not-found
		fi
		;;
	*) [ "$value" -eq 1 ] && echo "" || echo "" ;;
	esac
	exit 0
	;;
*)
	echo "fake systemctl: unsupported command: $cmd $*" >&2
	exit 1
	;;
esac
